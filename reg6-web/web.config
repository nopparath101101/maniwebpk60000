<?xml version="1.0" encoding="UTF-8"?>
<!-- สำหรับ IIS 7 (Windows Server 2008). IIS 6 (Server 2003) ไม่ใช้ไฟล์นี้ ให้ตั้ง Default Document เป็น index.html เอง
     และให้ลบหรือย้ายโฟลเดอร์ sync ออกจากเว็บไซต์ หรือปฏิเสธสิทธิ์เข้าถึงโฟลเดอร์นี้ -->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <httpProtocol>
      <customHeaders>
        <add name="X-UA-Compatible" value="IE=edge" />
      </customHeaders>
    </httpProtocol>
    <!-- ซ่อนโฟลเดอร์ sync (สคริปต์ซิงก์และไฟล์ log) ไม่ให้เปิดผ่านเว็บได้ -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="sync" />
          <add segment="api" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
  <!-- ให้เบราว์เซอร์ตรวจไฟล์ข้อมูลล่าสุดทุกครั้ง (ใช้ ETag จึงไม่ดาวน์โหลดซ้ำถ้าไม่เปลี่ยน) -->
  <location path="js/content.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
